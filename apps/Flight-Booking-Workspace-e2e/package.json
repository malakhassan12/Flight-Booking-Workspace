{
  "name": "@flight-booking-workspace/Flight-Booking-Workspace-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@flight-booking-workspace/Flight-Booking-Workspace"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@flight-booking-workspace/Flight-Booking-Workspace:build",
          "@flight-booking-workspace/Flight-Booking-Workspace:serve"
        ],
        "options": {
          "jestConfig": "apps/Flight-Booking-Workspace-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
